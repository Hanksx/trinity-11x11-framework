{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trinity Solver",
  "version": "5.0.1",
  "identifier": "com.nil.trinitysolver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "solver_backend": "solver_backend"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trinity Solver · 11×11",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:5173; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost http://localhost:5173"
    }
  }
}
